#include "buff.h"

circular_buff_t* init(int buff_size, int element_size){
	circular_buff_t *buffer = malloc(sizeof(circulat_buffer_t));	// init the circular buffer object

	buffer->element_size = element_size;
	buffer->max_size = buff_size;
	buffer->buff = malloc(buff_size);	// mallocs the amount of data needed into the heap
	buffer->head = 0;
	buffer->tail = 0;
}
