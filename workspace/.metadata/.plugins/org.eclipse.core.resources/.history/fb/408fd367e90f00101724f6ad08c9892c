	f_status = f_read(&file_in, (void*)Ybitstream, frame_size - 4 * sizeof(uint32_t), (UINT*)&num_bytes_read);
    //set the Cb and Cr bitstreams to point to the right location
    Cbbitstream = Ybitstream + Ysize;
