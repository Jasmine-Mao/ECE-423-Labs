<?xml version="1.0" encoding="UTF-8"?>
<sdx:platform sdx:vendor="xilinx.com"
              sdx:library="sdx"
              sdx:name="Assignment_2_Debugging"
              sdx:version="1.0"
              sdx:schemaVersion="1.0"
              xmlns:sdx="http://www.xilinx.com/sdx">
    <sdx:description>
Assignment_2_Debugging
    </sdx:description>
    <sdx:systemConfigurations sdx:defaultConfiguration="Assignment_2_Debugging">
        <sdx:configuration sdx:name="Assignment_2_Debugging"
                           sdx:displayName="Assignment_2_Debugging"
                           sdx:defaultProcessorGroup="standalone_domain"
                           sdx:runtimes="cpp">
            <sdx:description>Assignment_2_Debugging</sdx:description>
            <sdx:bootImages sdx:default="standard">
                <sdx:image sdx:name="standard"
                            sdx:bif="Assignment_2_Debugging/boot/Assignment_2_Debugging.bif"
                            sdx:readme="Assignment_2_Debugging/boot/generic.readme"
                            sdx:qemuArguments="Assignment_2_Debugging/qemu/qemu_args.txt"
                            />
                <sdx:image sdx:name="standalone_domain"
                            sdx:bif="Assignment_2_Debugging/boot/Assignment_2_Debugging.bif"
                            sdx:readme="Assignment_2_Debugging/boot/generic.readme"
                            sdx:qemuArguments="Assignment_2_Debugging/standalone_domain/qemu/qemu_args.txt"
                            />
            </sdx:bootImages>
            <sdx:processorGroup sdx:name="standalone_domain"
                                sdx:displayName="standalone on ps7_cortexa9_0"
                                sdx:cpuType="cortex-a9"
                                sdx:cpuInstance="ps7_cortexa9_0">
                <sdx:os sdx:name="standalone"
                        sdx:displayName="standalone"
                        sdx:bspLibraryPaths="Assignment_2_Debugging/standalone_domain/bsplib/lib"
                        sdx:bspIncludePaths="Assignment_2_Debugging/standalone_domain/bspinclude/include"
                        sdx:bspConfig="Assignment_2_Debugging/standalone_domain/system.mss"
                />
            </sdx:processorGroup>
        </sdx:configuration>
    </sdx:systemConfigurations>
</sdx:platform>
